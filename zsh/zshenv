# Dont read global configs
unsetopt GLOBAL_RCS

# export LC_ALL=en_GB.UTF-8
# export LC_COLLATE=C
# export LANG=en_GB.UTF-8

# Set the path to dotzsh.
export DOTZSH="$HOME/.zsh"

# User-local binaries (herdr, claude) for every shell, including the
# non-interactive ones `ssh host cmd` and herdr's saved machines start.
# zshrc prepends it again so interactive shells keep it first; -U dedupes.
typeset -U path PATH
path=("$HOME/.local/bin" $path)

# User-level toolchains, when installed: the .NET SDK from dotnet-install.sh
# and Rust from rustup (installed with --no-modify-path, so it is wired here).
if [[ -x "$HOME/.dotnet/dotnet" ]]; then
  export DOTNET_ROOT="$HOME/.dotnet"
  path=("$HOME/.dotnet" $path)
fi
[[ -d "$HOME/.dotnet/tools" ]] && path=("$HOME/.dotnet/tools" $path)
[[ -d "$HOME/.cargo/bin" ]] && path=("$HOME/.cargo/bin" $path)
export DOTNET_CLI_TELEMETRY_OPTOUT=1

# Linux shells that skip /etc/profile (GLOBAL_RCS is unset above, and `ssh host
# cmd` is neither login nor interactive) miss what Arch puts there: the perl
# tool dirs (shasum lives in core_perl) and /etc/locale.conf. Without a locale
# they run as POSIX, which breaks locale-sensitive dotnet tests.
if [[ "$OSTYPE" == linux* ]]; then
  [[ -d /usr/bin/core_perl ]] && path+=(/usr/bin/core_perl)
  [[ -z "${LC_ALL:-}" ]] && export LANG=en_GB.UTF-8 LC_ALL=en_GB.UTF-8
fi

# nvm's default Node for non-interactive shells (ssh host cmd, herdr panes),
# so node/npm globals (sechroom, codex, pnpm) resolve without sourcing the
# slow nvm.sh. Interactive shells still load nvm itself via the zshrc plugin.
_nvm_dir="${NVM_DIR:-$HOME/.nvm}"
if [[ -d "$_nvm_dir/versions/node" ]]; then
  _nvm_default=""
  [[ -r "$_nvm_dir/alias/default" ]] && _nvm_default="$(<"$_nvm_dir/alias/default")"
  _nvm_bin=""
  for _nvm_candidate in "v${_nvm_default#v}" "$_nvm_default"; do
    [[ -n "${_nvm_default}" && -d "$_nvm_dir/versions/node/$_nvm_candidate/bin" ]] \
      && _nvm_bin="$_nvm_dir/versions/node/$_nvm_candidate/bin" && break
  done
  if [[ -z "$_nvm_bin" ]]; then
    # Alias like lts/* or node, or none: use the newest installed version.
    _nvm_versions=("$_nvm_dir"/versions/node/v*(N/nOn))
    (( ${#_nvm_versions} )) && _nvm_bin="${_nvm_versions[1]}/bin"
  fi
  [[ -n "$_nvm_bin" ]] && path=("$_nvm_bin" $path)
fi
unset _nvm_dir _nvm_default _nvm_bin _nvm_candidate _nvm_versions

# Rootless Docker on Linux (sc-dev-01): point clients, including the .NET
# Testcontainers suites, at the user daemon when its socket exists. Hosts on
# the system daemon have no user socket and keep the default.
if [[ "$OSTYPE" == linux* && -z "${DOCKER_HOST:-}" ]]; then
  _docker_sock="${XDG_RUNTIME_DIR:-/run/user/$UID}/docker.sock"
  [[ -S "$_docker_sock" ]] && export DOCKER_HOST="unix://$_docker_sock"
  unset _docker_sock
fi

