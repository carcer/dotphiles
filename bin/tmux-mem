#!/usr/bin/env bash
# Print memory usage for the tmux status line (macOS).
# Reports "used/total G" where used = active + wired + compressed pages
# (roughly Activity Monitor's "Memory Used").

total_bytes=$(sysctl -n hw.memsize)

# Page size and used pages straight from vm_stat (no hardcoded page size).
read -r page_size used_pages < <(vm_stat | awk '
  /page size of/       { for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+$/) ps=$i }
  /Pages active/                 { gsub(/\./,"",$3); a=$3 }
  /Pages wired down/             { gsub(/\./,"",$4); w=$4 }
  /Pages occupied by compressor/ { gsub(/\./,"",$5); c=$5 }
  END { print ps, a+w+c }
')

used_bytes=$(( used_pages * page_size ))

awk -v u="$used_bytes" -v t="$total_bytes" \
  'BEGIN { printf "%.1f/%.0fG", u/1073741824, t/1073741824 }'
