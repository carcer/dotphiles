#!/usr/bin/env bash
# Collate where this host's disk went, grouped by who decides what goes:
#   disk-report            every section (a few minutes: it sizes the checkouts)
#   disk-report --quick    skip the per-checkout git details
#
# Read-only: it sizes and lists, and deletes nothing. Each line is
#   <size>  <path>  <note>
# with a section header naming the owner:
#   caches     regenerate on demand; the dotfiles lane may clear them (command given)
#   estate     an estate's temp or checkouts; its conductor decides
#   agents     Claude Code and Codex history; Chris decides
#   docker     images, volumes and the VM disk; never prune (other estates' data)
#   personal   apps, downloads, media; Chris decides
# Lines under 200 MB are left out unless they're in the totals.

set -uo pipefail

quick=0
[[ ${1:-} == --quick ]] && quick=1
min_kb=${DISK_REPORT_MIN_KB:-204800}
projects=$HOME/development/projects

kb() { du -sk -x "$1" 2>/dev/null | awk '{print $1}'; }

# row <path> <note>: "<kb><TAB><path>  <note>" for show to sort, total and filter.
row() {
  local k
  [[ -e $1 ]] || return 0
  k=$(kb "$1")
  [[ -n $k ]] && printf '%s\t%s  %s\n' "$k" "${1/#$HOME/~}" "$2"
  return 0
}
# show: rows largest first, those under the floor dropped, then the section total.
show() {
  sort -rn | awk -F '\t' -v min="$min_kb" '
    function h(k) { return k >= 1048576 ? sprintf("%6.1fG", k / 1048576) : sprintf("%6.0fM", k / 1024) }
    { t += $1; if ($1 >= min) print h($1) "  " $2 }
    END { print h(t) "  (section total)" }'
}
section() { printf '\n== %s\n' "$1"; }

echo "== $(hostname -s) $(date -u +%FT%TZ)"
if [[ $(uname) == Darwin ]]; then
  df -h /System/Volumes/Data | awk 'NR == 2 { print "data volume: " $4 " free of " $2 " (" $5 " used)" }'
else
  df -h "$HOME" | awk 'NR == 2 { print "home volume: " $4 " free of " $2 " (" $5 " used)" }'
fi
echo "estate page warns below 15% or 20 GiB free"

section "caches: regenerate on demand"
{
  row ~/.nuget/packages "dotnet nuget locals all --clear (no dotnet restore running)"
  row ~/.local/share/NuGet "dotnet nuget locals all --clear"
  row ~/.npm/_cacache "npm cache clean --force"
  row ~/.pnpm-store "pnpm store prune"
  row ~/Library/pnpm/store "pnpm store prune"
  row ~/Library/Caches/pnpm "pnpm store prune"
  row ~/.bun/install/cache "bun pm cache rm"
  row ~/.cache/uv "uv cache clean"
  row ~/.cache/puppeteer "re-downloads on use"
  row ~/.cache/ms-playwright "npx playwright install re-downloads"
  row ~/Library/Caches/ms-playwright "npx playwright install re-downloads"
  row ~/Library/Caches/ms-playwright-mcp "re-downloads on use"
  row ~/Library/Caches/Homebrew "brew cleanup -s"
  row ~/.cache/yarn "yarn cache clean"
  row ~/Library/Caches/Yarn "yarn cache clean"
  row ~/.cargo/registry "cargo cache, re-fetched"
  row ~/go/pkg/mod "go clean -modcache"
  row ~/Library/Developer/Xcode/DerivedData "Xcode rebuilds it"
  row ~/Library/Caches/JetBrains "per-IDE-version caches; old versions are dead"
  row ~/Library/Caches/com.spotify.client "Spotify re-downloads"
} | show

section "estate: lane temp under ~/.cache/dpt-tmp (dpt-tmp-prune clears units idle 3 days)"
if [[ -d ~/.cache/dpt-tmp ]]; then
  for d in ~/.cache/dpt-tmp/*/; do row "${d%/}" "lane temp"; done | show
fi

section "estate: checkouts (size, last commit, dirty files, branch, merged into origin's default)"
{
  for estate_dir in "$projects"/*estate "$projects"/abcs; do
    [[ -d $estate_dir ]] || continue
    for d in "$estate_dir"/*/; do
      d=${d%/}
      k=$(kb "$d"); [[ -n $k ]] || continue
      note="not a checkout"
      if (( ! quick && k >= min_kb )) && git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
        age=$(( ( $(date +%s) - $(git -C "$d" log -1 --format=%ct 2>/dev/null || date +%s) ) / 86400 ))
        dirty=$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        branch=$(git -C "$d" branch --show-current 2>/dev/null)
        base=$(git -C "$d" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
        merged=no
        git -C "$d" merge-base --is-ancestor HEAD "$base" 2>/dev/null && merged=yes
        note="${age}d, dirty ${dirty}, ${branch:-detached}, merged ${merged}"
      fi
      printf '%s\t%s  %s\n' "$k" "${d/#$HOME/~}" "$note"
    done
  done
  for d in "$projects"/*; do
    [[ $d == *estate || $d == */abcs ]] && continue
    row "$d" "project outside an estate"
  done
} | show

section "agents: Claude Code and Codex history"
{
  for m in ~/.codex/sessions/*/*; do row "$m" "codex sessions $(basename "$(dirname "$m")")-${m##*/}"; done
  row ~/.codex/thread_history_1.sqlite "codex thread history"
  for c in ~/.claude ~/.claude-ocd ~/.claude-abcs; do row "$c/projects" "transcripts"; done
} | show

section "docker: never prune (estates' containers and volumes)"
row ~/Library/Containers/com.docker.docker/Data/vms/0/data/Docker.raw "VM disk, allocated size" | show
command -v docker >/dev/null && docker system df 2>/dev/null | sed 's/^/  /'

section "personal: Chris decides"
{
  row ~/Downloads "downloads"
  row ~/.Trash "trash"
  if [[ -d ~/Library/Application\ Support ]]; then
    for d in ~/Library/Application\ Support/*/; do row "${d%/}" "app data"; done
  fi
  row ~/Library/Android "Android SDK and emulators"
  for d in /Applications/*.app ~/Applications/*; do row "$d" "application"; done
} | show

if [[ $(uname) == Darwin ]]; then
  snaps=$(tmutil listlocalsnapshots / 2>/dev/null | grep -c com.apple)
  printf '\nTime Machine local snapshots: %s\n' "$snaps"
fi
