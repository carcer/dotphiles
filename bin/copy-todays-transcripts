#!/usr/bin/env bash
# Copy Claude transcripts modified TODAY from the claude-abcs store to claude-ocd,
# preserving the projects/<slug>/ layout, and log the session ids.
#
#   copy-todays-transcripts            # copy, reporting every action
#   copy-todays-transcripts --dry-run  # report only, touch nothing
#   copy-todays-transcripts --date 2026-08-20
#
# Notes on two deliberate choices:
#   * Dates are compared via `stat`, NOT `find -newermt`. On this BSD find,
#     `-newermt` with a relative argument silently matches nothing (or
#     everything), which makes it useless as an "is it recent" test.
#   * An existing destination file is never silently clobbered. Identical files
#     are skipped; differing ones are backed up alongside before overwrite.

set -euo pipefail

SRC="${HOME}/.claude-abcs/projects"
DST="${HOME}/.claude-ocd/projects"
DAY="$(date +%F)"
DRY=0

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) DRY=1; shift ;;
    -d|--date)    DAY="${2:?--date needs YYYY-MM-DD}"; shift 2 ;;
    --src)        SRC="${2:?}"; shift 2 ;;
    --dst)        DST="${2:?}"; shift 2 ;;
    -h|--help)    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

[ -d "$SRC" ] || { printf 'source store not found: %s\n' "$SRC" >&2; exit 1; }
[ -d "$DST" ] || { printf 'destination store not found: %s\n' "$DST" >&2; exit 1; }

printf 'source      %s\n' "$SRC"
printf 'destination %s\n' "$DST"
printf 'date        %s%s\n\n' "$DAY" "$([ "$DRY" = 1 ] && printf '   (DRY RUN)')"

copied=0; skipped=0; overwritten=0; scanned=0

# -print0 so slugs or names containing spaces survive.
while IFS= read -r -d '' src; do
  scanned=$((scanned + 1))
  mday="$(stat -f '%Sm' -t '%F' "$src")"
  [ "$mday" = "$DAY" ] || continue

  slug="$(basename "$(dirname "$src")")"
  id="$(basename "$src" .jsonl)"
  dstdir="$DST/$slug"
  dst="$dstdir/$id.jsonl"
  size="$(stat -f '%z' "$src")"
  mtime="$(stat -f '%Sm' -t '%H:%M' "$src")"

  action=copy
  if [ -e "$dst" ]; then
    if cmp -s "$src" "$dst"; then action=identical; else action=overwrite; fi
  fi

  printf '%-10s %s  %8s b  %s  %s\n' "$action" "$mtime" "$size" "$id" "$slug"

  case "$action" in
    identical) skipped=$((skipped + 1)); continue ;;
  esac

  if [ "$DRY" = 0 ]; then
    mkdir -p "$dstdir"
    if [ "$action" = overwrite ]; then
      cp -p "$dst" "$dst.bak.$(date +%Y%m%d%H%M%S)"
    fi
    cp -p "$src" "$dst"
  fi

  case "$action" in
    copy)      copied=$((copied + 1)) ;;
    overwrite) overwritten=$((overwritten + 1)) ;;
  esac
done < <(find "$SRC" -type f -name '*.jsonl' -print0)

printf '\nscanned %d transcript(s); matched %s\n' "$scanned" "$DAY"
printf 'copied %d   overwritten %d (previous kept as .bak.<stamp>)   identical-skipped %d\n' \
  "$copied" "$overwritten" "$skipped"
[ "$DRY" = 1 ] && printf 'DRY RUN — nothing was written.\n'
exit 0
