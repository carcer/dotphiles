#!/usr/bin/env bash
# Restart one idle herdr agent onto the current Claude Code / codex / Node:
# exit it, start a fresh login shell in its pane, then resume the same session
# with the same account (CLAUDE_CONFIG_DIR) or codex arguments.
#   herdr-cycle-agent <pane-id> [session-id]
# (pass session-id when herdr doesn't know it, e.g. a codex lane started without hooks)
# Refuses unless the agent is idle or done. Claude's "background work is
# running" prompt is answered with "Move to background and exit", so the
# estate's background tasks keep running. Prints old -> new pid, version, Node.
set -u
pane=${1:?usage: herdr-cycle-agent <pane-id> [session-id]}
sid_override=${2:-}

info=$(herdr agent get "$pane" 2>/dev/null) || { echo "$pane: no agent"; exit 1; }
read -r kind status sid < <(python3 -c '
import sys,json
r=json.load(sys.stdin)["result"]; a=r.get("agent",r)
print(a["agent"], a["agent_status"], (a.get("agent_session") or {}).get("value") or "-")' <<<"$info")
case $status in idle|done) ;; *) echo "$pane: $kind is $status, skipped"; exit 2 ;; esac
[ -n "$sid_override" ] && sid=$sid_override
[ "$sid" = - ] && { echo "$pane: no session id, skipped"; exit 2; }

procs=$(herdr pane process-info --pane "$pane")
read -r pid cmd < <(python3 -c '
import sys,json
for p in json.load(sys.stdin)["result"]["process_info"]["foreground_processes"]:
    a=p["argv"]
    if (p.get("argv0") or a[0].rsplit("/",1)[-1])=="claude" or any(x.endswith("/codex") or x=="codex" for x in a[:2]):
        print(p["pid"], " ".join(a)); break' <<<"$procs")
[ -z "${pid:-}" ] && { echo "$pane: agent process not found"; exit 1; }

envof() {  # print one variable from a process's environment
  if [ -r /proc/$1/environ ]; then tr '\0' '\n' </proc/$1/environ | sed -n "s/^$2=//p"
  else ps eww -o command= -p "$1" | grep -oE "(^| )$2=[^ ]+" | sed "s/^ *$2=//"; fi
}

send() { herdr pane send-text "$pane" "$1" >/dev/null; herdr pane send-keys "$pane" Enter >/dev/null; }
screen() { herdr pane read "$pane" --source visible --format text | grep -v '^[[:space:]]*$' | tail -${1:-6}; }

# Someone (often Chris) may be typing into the pane: never append to their input.
# The agent's input line is the last "❯ …" (Claude) or "› …" (codex) line on screen.
# Claude's prompt suggestions and codex's placeholder are drawn dim (ESC[2m), so
# dim text there is not typing; anything else is.
pending=$(herdr pane read "$pane" --source visible --format ansi | grep -aE $'(❯|›)' | tail -1 | python3 -c '
import re,sys
line=sys.stdin.read()
line=re.split("❯|›",line,maxsplit=1)[-1]
line=re.sub(r"\x1b\[2m.*?(\x1b\[(0|22)?m|$)","",line)   # dim runs: suggestions
print(re.sub(r"\x1b\[[0-9;?]*[A-Za-z]","",line).strip())')
if [ -n "$pending" ]; then
  echo "$pane: input line not empty ('${pending:0:60}'), someone may be typing; skipped"; exit 2
fi

if [ "$kind" = claude ]; then
  cfg=$(envof "$pid" CLAUDE_CONFIG_DIR)
  relaunch="${cfg:+CLAUDE_CONFIG_DIR=$cfg }claude --resume $sid"
else
  # codex args minus a trailing "resume <id>" and the node/launcher prefix
  args=$(sed -E 's#^(node )?[^ ]*codex ?##; s# ?resume [^ ]+.*$##' <<<"$cmd")
  relaunch="codex ${args:+$args }resume $sid"
fi
echo "$pane: cycling $kind $pid; to recover by hand: exec \$SHELL -l; $relaunch"
if [ "$kind" = claude ]; then send /exit; else send /quit; fi

for i in $(seq 1 40); do
  kill -0 "$pid" 2>/dev/null || break
  if [ "$kind" = claude ] && screen 12 | grep -q 'Move to background and exit'; then
    herdr pane send-keys "$pane" Down Enter >/dev/null
  fi
  # codex's first Enter on "/quit" picks it from the command menu; the second runs it
  if [ "$kind" = codex ] && [ "$i" = 3 ]; then herdr pane send-keys "$pane" Enter >/dev/null; fi
  sleep 1
done
if kill -0 "$pid" 2>/dev/null; then echo "$pane: $pid still running, not relaunched"; screen 10; exit 1; fi

sleep 2; send 'exec $SHELL -l'; sleep 5
send "$relaunch"

new=
for i in $(seq 1 30); do
  new=$(herdr pane process-info --pane "$pane" | python3 -c '
import sys,json
for p in json.load(sys.stdin)["result"]["process_info"]["foreground_processes"]:
    a=p["argv"]
    if (p.get("argv0") or a[0].rsplit("/",1)[-1])=="claude" or any(x.endswith("/codex") or x=="codex" for x in a[:2]):
        print(p["pid"]); break' 2>/dev/null)
  [ -n "$new" ] && [ "$new" != "$pid" ] && break
  sleep 1
done
sleep 4
# A codex lane whose MCP tools/list times out (sechroom-ocd under load, required =
# true) exits back to the shell after starting. Wait until it shows its prompt, or
# report that it fell out (startup_timeout_sec is 120).
if [ "$kind" = codex ] && [ -n "$new" ]; then
  for i in $(seq 1 30); do
    kill -0 "$new" 2>/dev/null || { echo "$pane codex: FAILED, $new exited during startup (MCP timeout?); recover with: $relaunch"; screen 6; exit 1; }
    screen 3 | grep -q 'for agents\|? for shortcuts' && break
    sleep 5
  done
fi
echo "$pane $kind: $pid -> ${new:-NONE} node=$(envof "${new:-0}" NVM_BIN | grep -oE 'v[0-9.]+') ${cfg:+cfg=${cfg##*/}}${args:+args='$args'}"
screen 4

# Desk binds herdr panes by agent session id: a resume that lands on a different id
# (e.g. after an account move) silently breaks that binding.
now=$(herdr agent get "$pane" 2>/dev/null | python3 -c '
import sys,json
r=json.load(sys.stdin)["result"]; a=r.get("agent",r)
print((a.get("agent_session") or {}).get("value") or "")' 2>/dev/null)
if [ -n "$now" ] && [ "$now" != "$sid" ]; then
  echo "$pane: WARNING session id changed $sid -> $now; if Desk binds this pane, re-attach it in Desk"
fi
