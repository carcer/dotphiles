#!/usr/bin/env bash
# Prune stale estate lane temp under ~/.cache/dpt-tmp on the lane runners and the Mac.
#
# zshenv points each estate lane's TMPDIR at ~/.cache/dpt-tmp/<estate>-<lane> and
# CLAUDE_CODE_TMPDIR at <lane>/claude. Unlike the /tmp tmpfs they replaced,
# nothing caps or clears them, and they share /home with everything else.
#
# A unit is a top-level entry of a lane dir, or a Claude session dir
# (claude/claude-<uid>/<project>/<session-uuid>). A unit goes only when nothing
# in it changed for DPT_TMP_PRUNE_DAYS days (default 3) and no live process has
# its working directory or an open file inside it, so a long-running dev server
# in an old scratchpad worktree survives. Empty dirs are tidied afterwards.
# A unit holding git worktrees leaves their records in the owning repo, which
# breaks `sechroom lane` and the reporter's lane census, so each such repo gets
# a `git worktree prune` once the run is done.
#
#   dpt-tmp-prune        prune
#   dpt-tmp-prune -n     list what would go, delete nothing
#
# Run by systemd/user/dpt-tmp-prune.timer, and on the Mac by the launchd agent
# deploy/dpt-tmp-prune-mac installs. Needs bash 4 (Homebrew's on the Mac).

set -euo pipefail

root=${DPT_TMP_ROOT:-$HOME/.cache/dpt-tmp}
days=${DPT_TMP_PRUNE_DAYS:-3}
dry_run=0
[[ "${1:-}" == -n ]] && dry_run=1

[[ -d "$root" ]] || exit 0
# The real path, as lsof and /proc report it (/var is /private/var on macOS).
root=$(cd "$root" && pwd -P)

# Paths live processes hold inside the root: working directories and open files.
# With no way to see them, nothing is deleted: an empty list would mean "all idle".
busy=()
if [[ -d /proc/self/fd ]]; then
  for proc in /proc/[0-9]*; do
    for link in "$proc/cwd" "$proc"/fd/*; do
      target=$(readlink "$link" 2>/dev/null) || continue
      [[ "$target" == "$root/"* ]] && busy+=("$target")
    done
  done
else
  open=$(lsof -n -w -u "$(id -un)" -Fn 2>/dev/null) || { echo "dpt-tmp-prune: lsof failed" >&2; exit 1; }
  while IFS= read -r target; do
    [[ "$target" == "$root/"* ]] && busy+=("$target")
  done < <(printf '%s\n' "$open" | sed -n 's/^n//p')
fi

in_use() {
  local unit=$1 path
  for path in "${busy[@]}"; do
    [[ "$path" == "$unit" || "$path" == "$unit/"* ]] && return 0
  done
  return 1
}

units() {
  local lane entry
  for lane in "$root"/*/; do
    lane=${lane%/}
    for entry in "$lane"/* "$lane"/.[!.]*; do
      [[ -e "$entry" && "$entry" != "$lane/claude" ]] && printf '%s\n' "$entry"
    done
    [[ -d "$lane/claude" ]] && find "$lane/claude" -mindepth 3 -maxdepth 3 -type d \
      -name '????????-????-????-????-????????????'
  done
  return 0
}

# The common git dir of each worktree checked out in a unit (a `.git` file, not
# a dir), at any depth a lane uses: the unit itself, a checkout in it, or a
# session's scratchpad/<name>.
worktree_commons() {
  local f dir gd
  while IFS= read -r f; do
    gd=$(sed -n 's/^gitdir: //p' "$f" 2>/dev/null)
    [[ -n "$gd" ]] || continue
    dir=$(dirname "$f")
    # Resolve a relative gitdir now: it goes through the unit, which is deleted next.
    [[ "$gd" == /* ]] || gd=$(cd "$dir/${gd%/*}" 2>/dev/null && echo "$(pwd -P)/${gd##*/}") || continue
    [[ "$gd" == */worktrees/* ]] && printf '%s\n' "${gd%/worktrees/*}"
  done < <(find "$1" -maxdepth 4 -name .git -type f 2>/dev/null)
  return 0
}

declare -A commons=()
freed=0
while IFS= read -r unit; do
  [[ -n "$(find "$unit" -mmin "-$((days * 1440))" -print 2>/dev/null | head -1)" ]] && continue
  in_use "$unit" && continue
  kb=$(du -sk "$unit" 2>/dev/null | cut -f1)
  freed=$((freed + ${kb:-0}))
  if (( dry_run )); then
    echo "would remove ${kb}K $unit"
  else
    while IFS= read -r c; do
      [[ -n "$c" ]] && commons[$c]=1
    done < <(worktree_commons "$unit")
    echo "removing ${kb}K $unit"
    rm -rf -- "$unit"
  fi
done < <(units)

if (( ! dry_run )); then
  find "$root" -mindepth 2 -type d -empty -mmin "+$((days * 1440))" -delete 2>/dev/null || true
  for c in "${!commons[@]}"; do
    [[ -d "$c" ]] || continue
    if git --git-dir="$c" worktree prune 2>/dev/null; then
      echo "pruned worktree records in $c"
    else
      echo "dpt-tmp-prune: worktree prune failed in $c" >&2
    fi
  done
fi

echo "dpt-tmp-prune: $((freed / 1024))M $([[ $dry_run == 1 ]] && echo reclaimable || echo freed) under $root"
