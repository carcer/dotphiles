#!/bin/bash
# Modified blurlock script with fingerprint authentication support
# Removed -e flag to allow PAM authentication on empty password (for fingerprint)
set -eu

RESOLUTION=$(xrandr -q|sed -n 's/.*current[ ]\([0-9]*\) x \([0-9]*\),.*/\1x\2/p')

# lock the screen
# Note: Removed -e flag to enable PAM authentication with fingerprint
# Workflow: Lock screen → Press Enter → Scan fingerprint
import -silent -window root jpeg:- | convert - -scale 20% -blur 0x2.5 -resize 500% RGB:- | \
    i3lock --raw $RESOLUTION:rgb -i /dev/stdin $@

# sleep 1 adds a small delay to prevent possible race conditions with suspend
#sleep 1

exit 0
