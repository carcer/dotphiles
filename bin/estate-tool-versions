#!/usr/bin/env bash
# Read-only: installed vs latest herdr, Claude Code, codex, roslynk and .NET on the Mac
# and each lane runner, plus what a rollout has to wait for on each box.
#
#   estate-tool-versions [box-host ...]     (default: sc-dev-01 chris-framework)
#
# Latest versions come from the sources each host installs from: Homebrew for
# herdr on the Mac, GitHub releases for herdr on the box (`herdr update`), npm
# for Claude Code and codex, NuGet for roslynk, and dotnet/core's release notes for .NET (the
# Homebrew casks and the box's pacman packages trail those by a day or so).
# Run by the estate-tool-rollout skill; changes nothing.

set -uo pipefail
boxes=("$@")
(( ${#boxes[@]} )) || boxes=(sc-dev-01 chris-framework)

latest_herdr=$(gh release view -R herdrdev/herdr --json tagName --jq .tagName 2>/dev/null | sed 's/^v//')
brew_herdr=$(brew info --json=v2 herdr 2>/dev/null | jq -r '.formulae[0].versions.stable // empty')
latest_claude=$(npm view @anthropic-ai/claude-code version 2>/dev/null)
latest_codex=$(npm view @openai/codex version 2>/dev/null)
latest_roslynk=$(curl -sfL https://api.nuget.org/v3-flatcontainer/roslynk/index.json | jq -r '.versions[-1]')

echo "== latest"
printf '  herdr   %s (github)  %s (brew)\n' "${latest_herdr:-?}" "${brew_herdr:-?}"
printf '  claude  %s\n  codex   %s\n  roslynk %s\n' "${latest_claude:-?}" "${latest_codex:-?}" "${latest_roslynk:-?}"
for c in 10.0 9.0 8.0; do
  curl -sfL "https://raw.githubusercontent.com/dotnet/core/main/release-notes/$c/releases.json" \
    | jq -r '.releases[0] | "  dotnet  \(."release-version") sdk \(.sdk.version) \(."release-date")\(if .security then " SECURITY (\(."cve-list" | length) CVEs)" else "" end)"'
done

# Same report on both hosts: client binaries, the running herdr server, and
# which version each running agent process is on (they keep their binary
# until restarted).
report='
  printf "  herdr   %s; server %s\n" "$(herdr --version 2>/dev/null | cut -d" " -f2)" \
    "$(herdr status 2>/dev/null | awk "/^server:/{s=1} s&&/version:/{print \$2; exit}")"
  printf "  claude  %s\n  codex   %s\n" "$(claude --version 2>/dev/null | cut -d" " -f1)" "$(codex --version 2>/dev/null | tail -1 | cut -d" " -f2)"
  printf "  roslynk %s(%s running)\n" "$(cd ~ && dotnet tool list -g 2>/dev/null | awk "\$1==\"roslynk\"{printf \"%s \", \$2}")" "$(pgrep -f roslynk.stdio | wc -l | tr -d " ")"
  dotnet --list-runtimes 2>/dev/null | awk "/NETCore/{v=v\" \"\$2} END{print \"  dotnet \" v}"
  dotnet --list-sdks 2>/dev/null | awk "{v=v\" \"\$1} END{print \"  sdks   \" v}"
'
echo "== mac"
zsh -c "$report"
for box in "${boxes[@]}"; do
echo "== $box"
ssh -o BatchMode=yes -o ConnectTimeout=10 "$box" "zsh -c '$report'
  printf '  running claude: '
  for p in \$(pgrep -x claude); do readlink /proc/\$p/exe; done | xargs -rn1 basename | sort | uniq -c | tr '\n' ' '; echo
  printf '  dotnet test slots held: '; ls -d \${DPT_LOCK_ROOT:-/tmp}/dpt-integration*.lock.d 2>/dev/null | wc -l
  pacman -Q 2>/dev/null | awk '/^dotnet-(sdk|runtime)/{printf \"  pacman  %s %s\n\", \$1, \$2}'
  systemctl --user is-active herdr-server | sed 's/^/  herdr-server unit: /'" \
  || echo "  (unreachable)"
done
