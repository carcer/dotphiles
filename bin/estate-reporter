#!/usr/bin/env bash
# Post this host's lane state for one estate to Sechroom every minute (SBC-1977):
#   estate-reporter <estate> [host]
#
# One-shot per pass rather than `sechroom estate report --watch`, which exits on
# the first failed post. Run as a supervised service, not from a lane's shell:
# estate-reporter@.service on the runners, deploy/estate-reporter-mac on the Mac.
# It sets its own PATH because neither gives it a shell's.
#
# Three auth failures in a row write ~/estate-metrics/REPORTER-ALERT-<estate> and
# warn on stderr; the file goes away after the next good post. Conductors can test
# for it in their loops. A network failure is logged and retried, never alerted.

set -uo pipefail

estate=${1:?usage: estate-reporter <estate> [host]}
host=${2:-}
if [[ -z $host ]]; then
  case "$(hostname -s)" in
    Chriss-MacBook-Air) host=chris-mac ;;
    *) host=$(hostname -s) ;;
  esac
fi

nvm_bin=$(ls -d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | sort -V | tail -1)
export PATH="${nvm_bin:+$nvm_bin:}$HOME/.local/bin:/opt/homebrew/bin:$PATH"

dir=$HOME/.cache/sechroom-reporter
log=$dir/$estate.log
alert=$HOME/estate-metrics/REPORTER-ALERT-$estate
interval=${ESTATE_REPORTER_INTERVAL:-60}
# The runners keep a reporter install apart from the global CLI.
bin=${ESTATE_REPORTER_BIN:-$dir/node_modules/.bin/sechroom}
[[ -x $bin ]] || bin=$(command -v sechroom) || { echo "estate-reporter: no sechroom CLI" >&2; exit 1; }

mkdir -p "$dir" "${alert%/*}"
# Fixed so the tenant can't follow whichever checkout a shell happened to be in.
cd "$dir" || exit 1

# Host health (SBC-2222): one observation block per pass beside the lanes, sent with
# `estate report-health` once the CLI has it. Anything not measured goes as null,
# which the estate page shows as "not reported", never 0.
api=${ESTATE_REPORTER_API:-https://app.sechroom.ai}
case $estate in
  sechroom) estate_root=$HOME/development/projects/sechroom-estate ;;
  freedivr) estate_root=$HOME/development/projects/didactic-palm-tree-estate ;;
  abcs) estate_root=$HOME/development/projects/abcs ;;
  *) estate_root=$HOME ;;
esac
[[ -d $estate_root ]] || estate_root=$HOME
block=$dir/$estate.host.json

first_word() { "$@" 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+[0-9A-Za-z.+-]*' | head -1; }

# Lock dirs of the estates' integration-host-lock.sh: test slots are dpt-integration.lock.d
# and dpt-integration-<n>.lock.d; the build pool's -build locks aren't counted.
slots_held() { ls -1 "${DPT_LOCK_ROOT:-/tmp}/" 2>/dev/null | grep -cE "$1"; }

host_block() {
  local cores load1 load5 load15 mem_avail mem_total disk api_out api_rc code secs ip
  local api_ok=null latency=null category=null dns=null
  if [[ $(uname) == Darwin ]]; then
    cores=$(/usr/sbin/sysctl -n hw.logicalcpu)
    read -r load1 load5 load15 < <(/usr/sbin/sysctl -n vm.loadavg | tr -d '{}')
    mem_total=$(/usr/sbin/sysctl -n hw.memsize)
    # Free, inactive and speculative pages are what macOS hands out without swapping.
    mem_avail=$(vm_stat | awk -v ps="$(/usr/sbin/sysctl -n hw.pagesize)" '
      /^Pages (free|inactive|speculative):/ { gsub(/\./, "", $NF); n += $NF } END { if (n && ps) print n * ps }')
  else
    cores=$(nproc)
    read -r load1 load5 load15 _ < /proc/loadavg
    mem_total=$(awk '/^MemTotal:/ { print $2 * 1024 }' /proc/meminfo)
    mem_avail=$(awk '/^MemAvailable:/ { print $2 * 1024 }' /proc/meminfo)
  fi
  disk=$(df -Pk "$estate_root" | awk 'NR == 2 { print $4 * 1024, $2 * 1024 }')

  api_out=$(curl -s -o /dev/null -m 10 -w '%{http_code} %{time_total} %{remote_ip}' "$api/healthz")
  api_rc=$?
  read -r code secs ip <<< "$api_out"
  [[ -n $ip ]] && dns=true
  case $api_rc in
    0)
      if [[ $code == 2* ]]; then api_ok=true; latency=$(awk -v s="$secs" 'BEGIN { printf "%.0f", s * 1000 }')
      elif [[ $code == 503 ]]; then api_ok=false; category='"unavailable"'
      else api_ok=false; category='"http"'; fi ;;
    6) api_ok=false; category='"dns"'; dns=false ;;
    28) api_ok=false; category='"timeout"' ;;
    7) api_ok=false; category='"connection"' ;;
    35|51|58|60) api_ok=false; category='"tls"' ;;
    *) api_ok=false; category='"connection"' ;;
  esac

  jq -n \
    --arg sampled "$(date -u +%FT%TZ)" \
    --arg cli "$(first_word "$bin" --version)" \
    --arg claude "$(first_word claude --version)" \
    --arg codex "$(first_word codex --version)" \
    --arg cores "$cores" --arg l1 "$load1" --arg l5 "$load5" --arg l15 "$load15" \
    --arg mem_avail "$mem_avail" --arg mem_total "$mem_total" \
    --arg disk_free "${disk% *}" --arg disk_total "${disk#* }" \
    --argjson api_ok "$api_ok" --argjson latency "$latency" --argjson category "$category" \
    --argjson dns "$dns" \
    --arg slots "$(slots_held '^dpt-integration(-[0-9]+)?\.lock\.d$')" \
    --arg cargo "$(slots_held '^dpt-integration-cargo\.lock\.d$')" '
    def str: if . == "" then null else . end;
    def num: if . == "" then null else tonumber end;
    def per_cpu: if . == "" or $cores == "" or ($cores | tonumber) == 0 then null
      else ((tonumber / ($cores | tonumber)) * 100 | round / 100) end;
    { sampledAt: $sampled, cliVersion: ($cli | str), claudeVersion: ($claude | str), codexVersion: ($codex | str),
      normalizedLoad1Minute: ($l1 | per_cpu), normalizedLoad5Minutes: ($l5 | per_cpu),
      normalizedLoad15Minutes: ($l15 | per_cpu), loadUnit: (if $l1 == "" then null else "per-logical-cpu" end),
      availableMemoryBytes: ($mem_avail | num), totalMemoryBytes: ($mem_total | num),
      freeDiskBytes: ($disk_free | num), totalDiskBytes: ($disk_total | num),
      apiReachable: $api_ok, apiLatencyMilliseconds: $latency, apiFailureCategory: $category,
      dnsReachable: $dns, dotnetOccupiedSlots: ($slots | num), cargoOccupiedSlots: ($cargo | num) }'
}

# Each CLI call gets a time limit, so one slow call under load can't stall the pass
# past the estate page's 120 s stale window.
call_timeout=${ESTATE_REPORTER_CALL_TIMEOUT:-45}
cli() {
  if command -v timeout >/dev/null; then timeout -k 5 "$call_timeout" "$bin" --tenant ocd "$@"
  else "$bin" --tenant ocd "$@"; fi
}

# A CLI without the verb (or ESTATE_REPORTER_HOST_HEALTH=0) skips it. Rechecked every
# tenth pass, so a new CLI install switches it on without a restart.
has_health=0
report_health() {
  [[ ${ESTATE_REPORTER_HOST_HEALTH:-1} == 1 ]] || return 0
  if (( pass % 10 == 0 )); then
    has_health=0
    "$bin" estate --help 2>/dev/null | grep -q 'report-health' && has_health=1
  fi
  (( has_health )) || return 0
  host_block > "$block.new" && mv "$block.new" "$block" || { echo "$ts host: collect failed" >> "$log"; return 0; }
  local hout hrc
  hout=$(cli estate report-health "$estate" --host "$host" --file "$block" 2>&1)
  hrc=$?
  echo "$ts host rc=$hrc $(printf '%s' "$hout" | tail -2 | tr '\n' ' ' | cut -c1-200)" >> "$log"
}

# ESTATE_REPORTER_PRINT=1 estate-reporter <estate>: print one host block and exit.
[[ ${ESTATE_REPORTER_PRINT:-0} == 1 ]] && { host_block; exit; }

auth_failures=0
pass=0
while true; do
  started=$SECONDS
  ts=$(date -u +%FT%TZ)
  # Host facts first: they're cheap, and keep the host fresh when the lane report is slow.
  report_health
  out=$(cli estate report "$estate" --host "$host" 2>&1)
  rc=$?
  # The CLI reads its bearer once per command and doesn't retry a 401, so a token that
  # expires during a slow run fails the pass; a new process refreshes it.
  if [[ $rc -ne 0 ]] && printf '%s' "$out" | grep -q 'HTTP 401'; then
    echo "$ts rc=$rc 401, retrying with a fresh token" >> "$log"
    out=$(cli estate report "$estate" --host "$host" 2>&1)
    rc=$?
  fi
  [[ $rc -eq 124 ]] && out="timed out after ${call_timeout}s"
  echo "$ts rc=$rc $(printf '%s' "$out" | tail -3 | tr '\n' ' ' | cut -c1-300)" >> "$log"
  [ "$(wc -l < "$log")" -gt 2000 ] && tail -1000 "$log" > "$log.new" && mv "$log.new" "$log"

  if [[ $rc -eq 0 ]]; then
    auth_failures=0
    rm -f "$alert"
  elif printf '%s' "$out" | grep -qiE 'HTTP 401|unauthenticated|session expired|re-authenticate|sechroom login'; then
    auth_failures=$((auth_failures + 1))
    if [[ $auth_failures -ge 3 ]]; then
      echo "$ts $host: $auth_failures auth failures reporting $estate; try: sechroom login" | tee "$alert" >&2
    fi
  fi
  pass=$((pass + 1))
  # A fixed cadence: the pass's own time counts against the interval.
  wait=$((interval - (SECONDS - started)))
  (( wait > 0 )) && sleep "$wait"
done
