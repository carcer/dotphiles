#!/usr/bin/env bash
#
# dotphiles : https://github.com/dotphiles/dotphiles
#
# Script to bootstrap a linux box
#
# Authors:
#   Ben O'Hara <bohara@gmail.com>
#

if [[ "$OSTYPE" != "linux"* ]]; then
  echo "$0 : Will only run on Linux"
  exit 1
fi

set -euo pipefail

DIR=$(cd "$(dirname "$0")" && pwd)

read_manifest() {
  local manifest=$1
  sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$manifest"
}

install_manifest() {
  local manifest=$1
  shift
  local installer=("$@")
  local packages=()

  [[ -f "$manifest" ]] || return 0
  mapfile -t packages < <(read_manifest "$manifest")
  ((${#packages[@]})) || return 0
  "${installer[@]}" -S --needed --noconfirm "${packages[@]}"
}

source /etc/os-release
if [[ "${ID:-}" != cachyos && "${ID:-}" != arch && "${ID:-}" != manjaro ]]; then
  echo "Unsupported Linux distribution: ${ID:-unknown}" >&2
  exit 1
fi

sudo pacman -Syu --noconfirm
install_manifest "$DIR/packages/arch-repo" sudo pacman

if [[ -s "$DIR/packages/arch-aur" ]]; then
  if ! command -v yay >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm base-devel git
    build_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotphiles-yay.XXXXXX")
    trap 'rm -rf -- "$build_dir"' EXIT
    git clone https://aur.archlinux.org/yay-bin.git "$build_dir/yay-bin"
    (cd "$build_dir/yay-bin" && makepkg -si --needed --noconfirm)
  fi
  install_manifest "$DIR/packages/arch-aur" yay
fi

"$DIR/install-npm-globals.sh"
"$DIR/install-herdr.sh"
"$DIR/oh-my-zsh.sh"
sudo "$DIR/configure-system.sh"

