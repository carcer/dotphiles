Include /Users/chris/.colima/ssh_config

#Default GitHub
Host git.ocd.codes
  HostName github.com
  User git
  IdentityFile ~/.ssh/master/ocd
  # Keepalives: the pre-push gate holds this connection idle for minutes while it
  # runs lint, builds and vitest, and GitHub closes it before git sends the push
  # body (SIGPIPE, exit 141). Without these, ServerAliveInterval resolves to 0.
  # 30s x 20 = 10 min of tolerated silence. DLA-1507.
  ServerAliveInterval 30
  ServerAliveCountMax 20

Host irregular-apocalypse
  ServerAliveInterval 60
  ServerAliveCountMax 5
  HostName 65.109.122.248   # Replace with your VPS IP
  User chris              # Replace with your VPS user
  IdentityFile ~/.ssh/master/ocd   # Replace with the correct SSH key file
  
Host youthful-indiscretion
  ServerAliveInterval 60
  ServerAliveCountMax 5
  HostName 65.108.8.55
  User chris              
  IdentityFile ~/.ssh/master/ocd
  LocalForward 8000 localhost:8000
  LocalForward 6001 localhost:6001



# Andy's CachyOS herdr runner, shared to carcer@github over Tailscale (tcp/22 only).
