# # i3blocks config file
#
# Please see man i3blocks for a complete reference!
# The man page is also hosted at http://vivien.github.io/i3blocks
#
# List of valid properties:
#
# align
# color
# command
# full_text
# instance
# interval
# label
# min_width
# name
# separator
# separator_block_width
# short_text
# signal
# urgent

# Global properties
#
# The top properties below are applied to every block, but can be overridden.
# Each block command defaults to the script name to avoid boilerplate.
# Change $SCRIPT_DIR to the location of your scripts!
command=~/.dotfiles/i3blocks/i3blocks-contrib/$BLOCK_NAME/$BLOCK_NAME
separator_block_width=15
markup=none

# Generic media player support
#
# This displays "ARTIST - SONG" if a music is playing.
# Supported players are: spotify, vlc, audacious, xmms2, mplayer, and others.
[mediaplayer]
instance=spotify
interval=5
signal=10

# Network interface monitoring
#
# If the instance is not specified, use the interface used for default route.
# The adress can be forced to IPv4 or IPv6 with -4 or -6 switches.

[bandwidth2]
interval=persist
markup=pango
LABEL=
separator=false

[iface]
#IFACE=wlan0
color=#859900
interval=3600

[wifi]
# Let the blocklet discover the active wireless interface; persistent names can
# change across a clean install.
label=wifi:
interval=10
COLOR_GE80=#859900
COLOR_GE60=#2aa198
COLOR_GE40=#b58900
COLOR_LOWR=#dc322f
COLOR_DOWN=#dc322f

[expressvpn]
command=~/.dotfiles/i3blocks/expressvpn/expressvpn
interval=30

# CPU usage
#
# The script may be called with -w and -c switches to specify thresholds,
# see the script for details.
[cpu_usage]
label=cpu 
interval=10
min_width=CPU 100.00%
separator=false
separator_block_width=7

# Temperature
#
# Support multiple chips, though lm-sensors.
# The script may be called with -w and -c switches to specify thresholds,
# see the script for details.
[temperature]
interval=10
separator=false
separator_block_width=7

[load_average]
label=load  
interval=10
separator=false
separator_block_width=7

# Volume indicator
#
# The first parameter sets the step (and units to display)
# The second parameter overrides the mixer selection
# See the script for details.

# [volume]
# label=♪ 
# # label=VOL
# interval=once
# signal=10
#STEP=5%

# Memory usage
#
# The type defaults to "mem" if the instance is not specified.
[memory]
separator=false
separator_block_width=7
interval=30


#[memory]
#instance=swap
#interval=30
#separator=false

# Disk usage
#
# The directory defaults to $HOME if the instance is not specified.
# The script may be called with a optional argument to set the alert
# (defaults to 10 for 10%).
[disk]
label= ⛁ 
#DIR=/mnt/data
interval=30

# Battery indicator
#
# The battery instance defaults to 0.
# [battery]
# #label=BAT
# label=⚡
# interval=30

# Date Time
#

[time]
instance=uk
TZ=Europe/London
command=date '+%d.%m %H:%M'
interval=60

[weather]
command=curl -Ss 'https://wttr.in/utila?format=+%C+%t(%f)+%w\n'
interval=3600
color=#A4C2F4

[claude-status]
command=~/.dotfiles/i3blocks/claude-status/claude-status
interval=300
markup=pango


[time]
command=date '+%d.%m %H:%M'
interval=60
color=#CCCCCC

[battery2]
command=~/.dotfiles/i3blocks/battery2/battery2
interval=5
markup=pango
# min_width=bat: ■■■■■

# OpenVPN support
#
# Support multiple VPN, with colors.
