#!/usr/bin/env python3

from pathlib import Path


def read(path: Path, default: str = "") -> str:
    try:
        return path.read_text().strip()
    except (FileNotFoundError, PermissionError):
        return default


batteries = [
    supply
    for supply in Path("/sys/class/power_supply").iterdir()
    if read(supply / "type") == "Battery"
]

if not batteries:
    text = "<span color='#cb4b16'>󰂑 no battery</span>"
    percent = 100
else:
    percentages = [int(read(battery / "capacity", "0")) for battery in batteries]
    percent = round(sum(percentages) / len(percentages))
    states = {read(battery / "status", "Unknown") for battery in batteries}

    if "Charging" in states:
        icon = "󰂄"
    elif states == {"Full"}:
        icon = "󰁹"
    elif percent <= 10:
        icon = "󰁺"
    elif percent <= 30:
        icon = "󰁼"
    elif percent <= 60:
        icon = "󰁾"
    elif percent <= 80:
        icon = "󰂀"
    else:
        icon = "󰁹"

    if percent < 20:
        color = "#dc322f"
    elif percent < 30:
        color = "#cb4b16"
    elif percent < 60:
        color = "#b58900"
    else:
        color = "#859900"

    text = f"<span font_family='FiraCode Nerd Font Mono'>{icon}</span> <span color='{color}'>{percent}%</span>"

print(text)
print(text)
if percent < 10:
    raise SystemExit(33)
